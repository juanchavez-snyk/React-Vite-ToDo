{
  "name": "snyk-demo-todo-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React/Vite todo app used to demo Snyk Open Source, Code, IaC and Container",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"npm --prefix server run dev\"",
    "dev:web": "vite",
    "dev:api": "npm --prefix server run dev",
    "build": "vite build",
    "preview": "vite preview",
    "install:all": "npm install && npm --prefix server install"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "marked": "0.3.6",
    "lodash": "4.17.15",
    "axios": "0.21.1",
    "js-yaml": "3.13.0",
    "moment": "2.29.1",
    "minimist": "1.2.0",
    "serialize-javascript": "2.1.1",
    "ical.js": "1.5.0",
    "highcharts": "13.0.0",
    "pngquant-bin": "9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "5.0.0",
    "concurrently": "^8.2.2"
  }
}
