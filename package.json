{
  "name": "snyk-demo-todo-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React/Vite todo app - secure baseline",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"npm --prefix server run dev\"",
    "dev:web": "vite",
    "dev:api": "npm --prefix server run dev",
    "build": "vite build",
    "preview": "vite preview",
    "install:all": "npm install && npm --prefix server install"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "marked": "^15.0.7",
    "dompurify": "^3.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.11",
    "concurrently": "^9.1.2"
  }
}
